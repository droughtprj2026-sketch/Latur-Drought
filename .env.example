# ── Google Earth Engine (real-time pipeline) ───────────
GEE_PROJECT=your-gee-project-id
GEE_SERVICE_ACCOUNT_KEY=your-service-account-key.json

# ── Supabase ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...public-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key
DATABASE_URL=postgres://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require

# ── Backend ────────────────────────────────────────────
GO_API_PORT=8080
NODE_GATEWAY_PORT=4000

# ── Frontend (NEXT_PUBLIC_* exposed to browser) ───────
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...public-anon-key

# ── Pipeline ──────────────────────────────────────────
DATA_DIR=./data/raw
OUTPUT_DIR=./data/processed
DISTRICT_NAME=Latur
PIPELINE_SINCE=2026-01
PUSH_TO_SUPABASE=0
