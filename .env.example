# ============================================================
# Latur Drought Intelligence Platform — Environment Configuration
# ============================================================

# ============================================================
# 1. Vercel Deployment & GitHub Actions Secrets
# Configure these in GitHub Repository Settings -> Secrets and variables -> Actions
# ============================================================
VERCEL_TOKEN=your_vercel_personal_access_token     # Generate at https://vercel.com/account/tokens
VERCEL_ORG_ID=your_vercel_org_id                   # Found in Vercel project settings
VERCEL_PROJECT_ID=your_vercel_project_id           # Found in Vercel project settings

# ============================================================
# 2. Google Earth Engine (GEE)
# ============================================================
GEE_PROJECT=igneous-effort-511512-c8               # Cloud project "My Project 92976" (an id, not a secret)
GEE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}   # JSON key text (GitHub secret); the account must be registered for Earth Engine

# ============================================================
# 3. Supabase Cloud Database (PostgreSQL + PostGIS)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key   # SERVER SIDE ONLY (pipeline + GitHub secret, never NEXT_PUBLIC_)
SUPABASE_BUCKET=drought-data                        # public Storage bucket created by migration 0002
DATABASE_URL=postgres://postgres:your-db-password@db.your-project.supabase.co:5432/postgres?sslmode=require

# ============================================================
# 4. Frontend & Public Client Variables (NEXT_PUBLIC_*)
# Configure these in Vercel Project Settings -> Environment Variables
# ============================================================
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key
NEXT_PUBLIC_SUPABASE_BUCKET=drought-data
# Set to "static" to ignore Supabase and serve only the bundled /public/data snapshot.
NEXT_PUBLIC_DATA_SOURCE=supabase
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...optional-token

# ============================================================
# 5. Local Gateway & Processing Ports
# ============================================================
NODE_GATEWAY_PORT=4000
DISTRICT_NAME=Latur
DATA_DIR=./data/raw
OUTPUT_DIR=./data/processed
