# ============================================================
# Supabase
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key   # SERVER ONLY

# Postgres (same Supabase project, direct connection for Go)
DATABASE_URL=postgres://postgres:your-db-password@db.your-project.supabase.co:5432/postgres?sslmode=require

# ============================================================
# Backend ports
# ============================================================
GO_API_PORT=8080
NODE_GATEWAY_PORT=4000

# ============================================================
# Frontend (NEXT_PUBLIC_* are exposed to the browser)
# ============================================================
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key

# ============================================================
# Processing (Python)
# ============================================================
DATA_DIR=./data/raw
OUTPUT_DIR=./data/processed
DISTRICT_NAME=Latur
